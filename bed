#!/usr/bin/env python3
"""
bed - Browser-based Editor for local plain text and .link files.
Zero dependencies. Pure Python standard library.
"""

import http.server
import json
import os
import subprocess
import sys
import threading
import time
import webbrowser

PORT = 8765
last_ping = time.time()
running = True

# --- macOS Native Installation Routine ---

def install_macos():
    """Compiles Bed.app and registers file associations with macOS LaunchServices."""
    script_path = os.path.abspath(os.path.realpath(__file__))
    app_dir = os.path.expanduser("~/Applications/Bed.app")
    lsregister = "/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
    
    print(f"Installing Bed.app for: {script_path}")
    
    # 1. Unregister previous instance
    if os.path.exists(lsregister) and os.path.exists(app_dir):
        subprocess.run([lsregister, "-u", app_dir], stderr=subprocess.DEVNULL)
        
    os.makedirs(os.path.join(app_dir, "Contents/MacOS"), exist_ok=True)
    os.makedirs(os.path.join(app_dir, "Contents/Resources"), exist_ok=True)

    # 2. Native Cocoa launcher source
    launcher_src = f"""#import <Cocoa/Cocoa.h>

#define TARGET_SCRIPT_PATH @"{script_path}"

@interface AppDelegate : NSObject <NSApplicationDelegate>
@property (nonatomic, assign) BOOL fileHandled;
@end

@implementation AppDelegate

- (void)openScriptWithFile:(NSString *)path {{
    self.fileHandled = YES;
    NSTask *task = [[NSTask alloc] init];
    task.launchPath = @"/usr/bin/python3";
    task.arguments = @[TARGET_SCRIPT_PATH, path];
    task.standardOutput = [NSFileHandle fileHandleWithNullDevice];
    task.standardError = [NSFileHandle fileHandleWithNullDevice];
    [task launchAndReturnError:nil];

    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.2 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{{
        [NSApp terminate:nil];
    }});
}}

- (BOOL)application:(NSApplication *)sender openFile:(NSString *)filename {{
    [self openScriptWithFile:filename];
    return YES;
}}

- (void)application:(NSApplication *)sender openFiles:(NSArray<NSString *> *)filenames {{
    for (NSString *file in filenames) {{
        [self openScriptWithFile:file];
    }}
    [sender replyToOpenOrPrint:NSApplicationDelegateReplySuccess];
}}

- (void)application:(NSApplication *)application openURLs:(NSArray<NSURL *> *)urls {{
    for (NSURL *url in urls) {{
        if ([url isFileURL]) {{
            [self openScriptWithFile:[url path]];
        }}
    }}
    [application replyToOpenOrPrint:NSApplicationDelegateReplySuccess];
}}

- (void)applicationDidFinishLaunching:(NSNotification *)notification {{
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{{
        if (!self.fileHandled) {{
            NSTask *task = [[NSTask alloc] init];
            task.launchPath = @"/usr/bin/python3";
            task.arguments = @[TARGET_SCRIPT_PATH];
            [task launchAndReturnError:nil];
            [NSApp terminate:nil];
        }}
    }});
}}
@end

int main(int argc, const char * argv[]) {{
    @autoreleasepool {{
        NSApplication *app = [NSApplication sharedApplication];
        AppDelegate *delegate = [[AppDelegate alloc] init];
        [app setDelegate:delegate];
        [app run];
    }}
    return 0;
}}
"""
    tmp_m = "/tmp/bed_launcher.m"
    bin_path = os.path.join(app_dir, "Contents/MacOS/Bed")
    with open(tmp_m, "w") as f:
        f.write(launcher_src)

    print("Compiling native macOS launcher binary...")
    compile_res = subprocess.run([
        "clang", "-fobjc-arc", "-framework", "Cocoa", "-O2",
        tmp_m, "-o", bin_path
    ])
    if os.path.exists(tmp_m):
        os.remove(tmp_m)

    if compile_res.returncode != 0:
        print("Error: Clang compilation failed. Ensure Xcode Command Line Tools are installed.")
        sys.exit(1)

    # 3. Write Info.plist with Document Types and Exported UTIs for .link
    plist_path = os.path.join(app_dir, "Contents/Info.plist")
    plist_content = """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>Bed</string>
    <key>CFBundleIdentifier</key>
    <string>com.local.bed</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Bed</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Link Document</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>link</string>
                <string>uri</string>
                <string>txt</string>
                <string>md</string>
                <string>ini</string>
            </array>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.local.bed.link</string>
                <string>public.plain-text</string>
                <string>public.data</string>
            </array>
        </dict>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.local.bed.link</string>
            <key>UTTypeDescription</key>
            <string>Link Document</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.plain-text</string>
                <string>public.data</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>link</string>
                    <string>uri</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
"""
    with open(plist_path, "w") as f:
        f.write(plist_content)

    # 4. Ad-hoc sign bundle
    print("Signing Bed.app bundle...")
    subprocess.run(["codesign", "--force", "--deep", "--sign", "-", app_dir], check=True)

    # 5. Register with LaunchServices
    if os.path.exists(lsregister):
        print("Registering with macOS LaunchServices...")
        subprocess.run([lsregister, "-f", "-r", app_dir], check=True)

    subprocess.run(["killall", "Finder"], stderr=subprocess.DEVNULL)
    print("\n✓ Installation Complete! Bed.app is registered in ~/Applications.")
    print("To set as default: Right-click any .link or .txt file -> Get Info -> Open With: Bed.app -> Change All...")
    sys.exit(0)


# --- CLI Routing ---

if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
    if len(sys.argv) >= 2 and sys.argv[1] == "--install":
        if sys.platform == "darwin":
            install_macos()
        else:
            print("Installation helper is currently tailored for macOS. On Linux/Windows, bind 'bed <file>' to your file manager.")
            sys.exit(0)
    print("Usage: bed <path-to-file>")
    print("       bed --install    (Registers Bed.app in ~/Applications on macOS)")
    sys.exit(1)

if sys.argv[1] == "--install":
    if sys.platform == "darwin":
        install_macos()
    else:
        print("Installation helper is currently tailored for macOS.")
        sys.exit(0)

TARGET_FILE = os.path.abspath(sys.argv[1])

# --- Web Application Frontend ---

HTML_TEMPLATE = """<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>__TITLE__</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { margin: 0; background: #1e1e2e; color: #cdd6f4; display: flex; flex-direction: column; height: 100vh; font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; }
  #bar { 
    padding: 6px 14px; 
    background: #181825; 
    font-size: 12px; 
    border-bottom: 1px solid #313244; 
    display: flex; 
    align-items: center; 
    justify-content: space-between; 
    gap: 12px; 
    user-select: none;
  }
  #file-container { display: flex; align-items: center; gap: 6px; flex: 1; min-width: 0; }
  #dir-path { color: #6c7086; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 45%; }
  #filename {
    background: #313244; color: #cdd6f4; border: 1px solid #45475a; border-radius: 4px;
    padding: 3px 8px; font-family: inherit; font-size: 12px; font-weight: 600;
    outline: none; min-width: 140px; transition: border-color 0.15s ease;
  }
  #filename:focus { border-color: #89b4fa; background: #1e1e2e; }
  #msg { color: #a6adc8; white-space: nowrap; font-size: 11px; }
  textarea { 
    flex: 1; background: transparent; color: inherit; font-family: inherit;
    font-size: 14px; padding: 14px; border: none; outline: none; tab-size: 4;
    line-height: 1.6; resize: none;
  }
</style>
</head>
<body>
<div id="bar">
  <div id="file-container">
    <span id="dir-path">__DIR__/</span>
    <input id="filename" type="text" value="__TITLE__" spellcheck="false" title="Edit filename and press Enter/Cmd+S to save" />
  </div>
  <span id="msg"><b>Ctrl/Cmd+S</b> Save | <b>Ctrl/Cmd+Enter</b> Open Link</span>
</div>
<textarea id="t" autofocus>__CONTENT__</textarea>
<script>
const t = document.getElementById('t');
const fnameInput = document.getElementById('filename');
const msg = document.getElementById('msg');

function extractUrlFromLine(line) {
  const iniMatch = line.match(/^URL\\s*=\\s*(.+)$/i);
  const target = iniMatch ? iniMatch[1].trim() : line.trim();
  const match = target.match(/https?:\\/\\/[^\\s"'<>]+/i);
  if (match) return match[0];
  if (/^(www\\.|[a-zA-Z0-9-]+\\.[a-zA-Z]{2,})(\\/[^\\s"'<>]*)?$/i.test(target)) {
    return 'https://' + target;
  }
  return null;
}

function openCurrentLineUrl() {
  const pos = t.selectionStart;
  const text = t.value;
  const lineStart = text.lastIndexOf('\\n', pos - 1) + 1;
  let lineEnd = text.indexOf('\\n', pos);
  if (lineEnd === -1) lineEnd = text.length;
  
  const currentLine = text.substring(lineStart, lineEnd);
  const url = extractUrlFromLine(currentLine);
  
  if (url) {
    window.open(url, '_blank', 'noopener,noreferrer');
    msg.textContent = `Opened: ${url.length > 30 ? url.slice(0, 30) + '...' : url}`;
  } else {
    msg.textContent = 'No valid URL found on active line';
    setTimeout(() => {
      msg.innerHTML = '<b>Ctrl/Cmd+S</b> Save | <b>Ctrl/Cmd+Enter</b> Open Link';
    }, 2500);
  }
}

async function saveFile() {
  const filename = fnameInput.value.trim();
  if (!filename) {
    msg.textContent = 'Filename cannot be empty';
    return;
  }
  try {
    const res = await fetch('/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ filename: filename, content: t.value })
    });
    if (res.ok) {
      const data = await res.json();
      document.title = data.filename;
      fnameInput.value = data.filename;
      msg.textContent = `Saved as ${data.filename} (${new Date().toLocaleTimeString()})`;
    } else {
      msg.textContent = 'Save failed on server';
    }
  } catch (err) {
    msg.textContent = 'Save network error';
  }
}

window.addEventListener('keydown', e => {
  if ((e.ctrlKey || e.metaKey) && e.key === 's') {
    e.preventDefault();
    saveFile();
  } else if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
    e.preventDefault();
    openCurrentLineUrl();
  } else if (e.key === 'Tab' && document.activeElement === t) {
    e.preventDefault();
    const s = t.selectionStart, end = t.selectionEnd;
    t.value = t.value.substring(0, s) + '    ' + t.value.substring(end);
    t.selectionStart = t.selectionEnd = s + 4;
  }
});

fnameInput.addEventListener('keydown', e => {
  if (e.key === 'Enter') {
    e.preventDefault();
    saveFile();
    t.focus();
  }
});

setInterval(() => navigator.sendBeacon('/heartbeat'), 1000);
window.addEventListener('pagehide', () => navigator.sendBeacon('/shutdown'));
</script>
</body>
</html>"""

# --- HTTP Server Engine ---

class EditorHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        global last_ping
        last_ping = time.time()
        
        if not os.path.exists(TARGET_FILE):
            with open(TARGET_FILE, 'w', encoding='utf-8') as f:
                f.write('')

        with open(TARGET_FILE, 'r', encoding='utf-8', errors='replace') as f:
            content = f.read()
            
        escaped_content = (content
            .replace('&', '&amp;')
            .replace('<', '&lt;')
            .replace('>', '&gt;'))
            
        dir_name = os.path.dirname(TARGET_FILE)
        base_name = os.path.basename(TARGET_FILE)

        body = (HTML_TEMPLATE
            .replace('__DIR__', dir_name)
            .replace('__TITLE__', base_name)
            .replace('__CONTENT__', escaped_content))
                            
        self.send_response(200)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.end_headers()
        self.wfile.write(body.encode('utf-8'))

    def do_POST(self):
        global last_ping, running, TARGET_FILE
        last_ping = time.time()
        
        if self.path == '/save':
            length = int(self.headers.get('Content-Length', 0))
            payload = json.loads(self.rfile.read(length).decode('utf-8'))
            new_filename = os.path.basename(payload.get('filename', '').strip())
            content = payload.get('content', '')
            
            if not new_filename:
                self.send_response(400)
                self.end_headers()
                return

            new_target = os.path.join(os.path.dirname(TARGET_FILE), new_filename)
            if new_target != TARGET_FILE and os.path.exists(TARGET_FILE):
                try:
                    os.rename(TARGET_FILE, new_target)
                except OSError:
                    pass
            
            TARGET_FILE = new_target
            with open(TARGET_FILE, 'w', encoding='utf-8') as f:
                f.write(content)
                
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.end_headers()
            self.wfile.write(json.dumps({'filename': new_filename}).encode('utf-8'))
            
        elif self.path == '/heartbeat':
            self.send_response(204)
            self.end_headers()

        elif self.path == '/shutdown':
            self.send_response(204)
            self.end_headers()
            running = False
            threading.Thread(target=httpd.shutdown, daemon=True).start()

    def log_message(self, format, *args):
        return

http.server.HTTPServer.allow_reuse_address = True
httpd = http.server.HTTPServer(('127.0.0.1', PORT), EditorHandler)

def watchdog():
    global running
    time.sleep(5)
    while running:
        if time.time() - last_ping > 3.0:
            running = False
            httpd.shutdown()
            break
        time.sleep(1)

threading.Thread(target=watchdog, daemon=True).start()
webbrowser.open(f"http://127.0.0.1:{PORT}")

try:
    httpd.serve_forever()
finally:
    httpd.server_close()
    sys.exit(0)